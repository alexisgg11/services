# Copiar como .env dentro de abastecimiento; no subir credenciales a Git.
DB_URL=jdbc:postgresql://localhost:5432/panaderia_abastecimiento
DB_USER=
DB_PASSWORD=
APP_HOST=127.0.0.1
PORT=8080
# Límites opcionales; estos valores también están validados en AppConfig.
DB_POOL_SIZE=5
HTTP_THREADS=8
DB_QUERY_TIMEOUT_SECONDS=10
DB_CONNECTION_TIMEOUT_SECONDS=20
