# Copiar como .env.supabase; conserva .env para PostgreSQL local.
# Copia host y usuario de Supabase: Connect > Session pooler.
DB_URL=jdbc:postgresql://HOST_SESSION_POOLER:5432/postgres?sslmode=require
DB_USER=postgres.REFERENCIA_PROYECTO
DB_PASSWORD=
APP_HOST=127.0.0.1
PORT=8080
DB_POOL_SIZE=5
HTTP_THREADS=8
DB_QUERY_TIMEOUT_SECONDS=10
